# --- Frontend (exposed to the browser, must be prefixed VITE_) ---
# Find these in Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Netlify Functions only (server-side, NEVER prefix with VITE_) ---
# Also from Supabase: Project Settings -> API -> service_role key (keep secret!)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-v3-api-key

# Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-key
